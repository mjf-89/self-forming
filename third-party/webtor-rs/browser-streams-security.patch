+// Global across clients: bounded bootstrap work as well as per-request byte caps.
+static DIRECTORY_LOADS: AtomicUsize = AtomicUsize::new(0);
+struct DirectoryBudget;
+impl DirectoryBudget {
+    fn reserve() -> Result<Self> {
