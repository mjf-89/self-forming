+        if let Some(channel) = bridge_channel {
+            let started = crate::time::Instant::now();
+            // The bridge download is idempotent: on a stream/channel failure it
+            // is retried (bounded, with backoff). `force = true` on a retry
+            // asks the caller to discard a stalled/dead bridge channel and
+            // build a fresh one before the next attempt. Each attempt is
+            // bounded by `BRIDGE_BOOTSTRAP_TIMEOUT`; the whole retry is also
+            // bounded by the caller's cancellation token.
+            let run_once = |chan: Arc<Channel>| {
+                let bridge = self.fetch_from_bridge(chan);
+                async move {
+                    with_timeout(BRIDGE_ATTEMPT_TIMEOUT, "bridge_directory_attempt", bridge).await
+                }
+            };
+            let retry = crate::retry::retry_with_fresh(
+                BRIDGE_DOWNLOAD_ATTEMPTS,
+                BRIDGE_RETRY_BACKOFF,
+                |force| channel(force),
+                run_once,
+            );
