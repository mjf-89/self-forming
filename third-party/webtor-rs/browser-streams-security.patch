+            // 240 s budget and the caller's cancellation token.
+            let result = match cancel {
+                Some(token) => {
+                    with_timeout_and_cancellation(
+                        BRIDGE_BOOTSTRAP_TIMEOUT,
+                        "bridge_directory_bootstrap",
+                        token,
+                        retry,
+                    )
+                    .await
+                }
+                None => {
+                    with_timeout(BRIDGE_BOOTSTRAP_TIMEOUT, "bridge_directory_bootstrap", retry)
+                        .await
+                }
+            };
+            match result {
+                Ok(()) => {
+                    info!(
+                        "Directory downloaded from the bridge over Tor in {:?} ({} bytes transferred)",
+                        started.elapsed(),
+                        self.last_load_bytes()
+                    );
+                    return Ok(DirectoryLoadOutcome::Loaded(DirectorySourceKind::Bridge));
+                }
+                Err(e) => {
+                    warn!("Bridge directory download failed after retries: {}", e);
+                    last_error = Some(e);
+                }
+            }
+        }
