+/// A bidirectional byte stream through a Tor exit.
+///
+/// The read and write halves are locked independently, so a pending `read()`
+/// never blocks `write()`. Call `close()` when done (idempotent).
+#[wasm_bindgen]
+pub struct TorStream {
+    state: Rc<StreamState>,
+}
+
+struct CountGuard(Rc<Cell<usize>>);
+impl CountGuard {
+    fn reserve(count: Rc<Cell<usize>>) -> Self {
+        count.set(count.get() + 1);
+        Self(count)
+    }
+}
+impl Drop for CountGuard {
+    fn drop(&mut self) {
+        self.0.set(self.0.get() - 1);
+    }
+}
+
+struct StreamState {
+    queued_reads: Rc<Cell<usize>>,
+    queued_writes: Rc<Cell<usize>>,
+    queued_bytes: Rc<Cell<usize>>,
+    reader: Rc<futures::lock::Mutex<Option<Reader>>>,
+    writer: Rc<futures::lock::Mutex<Option<Writer>>>,
+    /// Cancels the read in progress (used by `close()`).
+    pending_read: Rc<RefCell<Option<AbortHandle>>>,
+    pending_write: Rc<RefCell<Option<AbortHandle>>>,
+    closed: Rc<Cell<bool>>,
+}
+
+impl TorStream {
+    fn new<S>(stream: S) -> Self
+    where
+        S: futures::io::AsyncRead + futures::io::AsyncWrite + Unpin + 'static,
+    {
+        let (reader, writer) = futures::io::AsyncReadExt::split(stream);
+        TorStream {
+            state: Rc::new(StreamState {
+                queued_reads: Rc::new(Cell::new(0)),
+                queued_writes: Rc::new(Cell::new(0)),
+                queued_bytes: Rc::new(Cell::new(0)),
+                reader: Rc::new(futures::lock::Mutex::new(Some(Box::new(reader) as Reader))),
+                writer: Rc::new(futures::lock::Mutex::new(Some(Box::new(writer) as Writer))),
+                pending_read: Rc::new(RefCell::new(None)),
+                pending_write: Rc::new(RefCell::new(None)),
+                closed: Rc::new(Cell::new(false)),
+            }),
+        }
+    }
+}
+
+#[wasm_bindgen]
+impl TorStream {
+    /// Write all of `data` and flush it to the circuit.
+    #[wasm_bindgen(unchecked_return_type = "Promise<void>")]
+    pub fn write(&self, data: js_sys::Uint8Array) -> js_sys::Promise {
+        let length = data.length() as usize;
+        if self.state.closed.get()
+            || length > 256 * 1024
+            || self.state.queued_writes.get() >= 4
+            || length > (256 * 1024usize).saturating_sub(self.state.queued_bytes.get())
+        {
+            return js_sys::Promise::reject(&stream_error(
+                "stream closed or write capacity reached".into(),
+            ));
+        }
+        let queued = CountGuard::reserve(self.state.queued_writes.clone());
+        self.state
+            .queued_bytes
+            .set(self.state.queued_bytes.get() + length);
+        struct ByteGuard(Rc<Cell<usize>>, usize);
+        impl Drop for ByteGuard {
+            fn drop(&mut self) {
+                self.0.set(self.0.get() - self.1);
+            }
+        }
+        let bytes = ByteGuard(self.state.queued_bytes.clone(), length);
+        let data = data.to_vec(); // Copy only AFTER limits and reservations.
+        let writer = self.state.writer.clone();
+        let closed = self.state.closed.clone();
+        let pending_write = self.state.pending_write.clone();
+        let pending_read = self.state.pending_read.clone();
+        future_to_promise(async move {
+            let _queued = queued;
+            let _bytes = bytes;
+            let mut guard = writer.lock().await;
+            if closed.get() {
+                return Err(stream_error("stream is closed".into()));
+            }
+            let w = guard
+                .as_mut()
+                .ok_or_else(|| stream_error("stream is closed".into()))?;
+            let (abort, registration) = AbortHandle::new_pair();
+            *pending_write.borrow_mut() = Some(abort);
+            let result = Abortable::new(
+                async {
+                    w.write_all(&data).await?;
+                    w.flush().await
+                },
+                registration,
+            )
+            .await;
+            pending_write.borrow_mut().take();
+            match result {
+                Ok(Ok(())) => Ok(JsValue::UNDEFINED),
+                Ok(Err(e)) => {
+                    // A failed write kills the stream (END cell, circuit gone).
+                    // Mark it closed so the client's stream slot is released
+                    // even if the caller never calls close().
+                    closed.set(true);
+                    if let Some(abort) = pending_read.borrow_mut().take() {
+                        abort.abort();
+                    }
+                    guard.take();
+                    Err(stream_error(format!("write failed: {}", e)))
+                }
+                Err(_) => Err(stream_error("stream closed during write".into())),
+            }
+        })
+    }
+
+    /// Next available chunk (at most 64 KiB), or `undefined` at EOF / after close.
+    #[wasm_bindgen(unchecked_return_type = "Promise<Uint8Array | undefined>")]
+    pub fn read(&self) -> js_sys::Promise {
+        if self.state.closed.get() {
+            return js_sys::Promise::resolve(&JsValue::UNDEFINED);
+        }
+        if self.state.queued_reads.get() >= 4 {
+            return js_sys::Promise::reject(&stream_error("read capacity reached".into()));
+        }
+        let queued = CountGuard::reserve(self.state.queued_reads.clone());
+        let reader = self.state.reader.clone();
+        let pending_read = self.state.pending_read.clone();
+        let pending_write = self.state.pending_write.clone();
+        let closed = self.state.closed.clone();
+        future_to_promise(async move {
+            let _queued = queued;
+            let mut guard = reader.lock().await;
+            let Some(r) = guard.as_mut() else {
+                return Ok(JsValue::UNDEFINED);
+            };
+            if closed.get() {
+                *guard = None;
+                return Ok(JsValue::UNDEFINED);
+            }
+            let (abort, registration) = AbortHandle::new_pair();
+            *pending_read.borrow_mut() = Some(abort);
+            let mut buf = vec![0u8; READ_CHUNK];
+            let result = Abortable::new(r.read(&mut buf), registration).await;
+            pending_read.borrow_mut().take();
+            match result {
+                Ok(Ok(n)) if n > 0 => Ok(js_sys::Uint8Array::from(&buf[..n]).into()),
+                Ok(Ok(_)) | Err(_) => {
+                    // EOF, or aborted by close()
+                    *guard = None;
+                    Ok(JsValue::UNDEFINED)
+                }
+                Ok(Err(e)) => {
+                    // A read error is terminal for this stream (END cell,
+                    // CONNRESET, oversized frame). Release the client's stream
+                    // slot instead of waiting for an explicit close().
+                    closed.set(true);
+                    if let Some(abort) = pending_write.borrow_mut().take() {
+                        abort.abort();
+                    }
+                    *guard = None;
+                    Err(stream_error(format!("read failed: {}", e)))
+                }
+            }
+        })
+    }
+
+    /// Close the stream (idempotent). A pending `read()` resolves `undefined`.
+    #[wasm_bindgen(unchecked_return_type = "Promise<void>")]
+    pub fn close(&self) -> js_sys::Promise {
+        let state = self.state.clone();
+        state.cancel();
+        future_to_promise(async move {
+            state.cleanup().await;
+            Ok(JsValue::UNDEFINED)
+        })
+    }
+}
+
+impl StreamState {
+    fn cancel(&self) {
+        self.closed.set(true);
+        if let Some(abort) = self.pending_read.borrow_mut().take() {
+            abort.abort();
+        }
+        if let Some(abort) = self.pending_write.borrow_mut().take() {
+            abort.abort();
+        }
+    }
+    async fn cleanup(&self) {
+        self.writer.lock().await.take();
+        self.reader.lock().await.take();
+    }
+}
+impl Drop for StreamState {
+    fn drop(&mut self) {
+        self.cancel();
+        // Pending operations own the individual lock Rc's, not this state.
+        // Aborting them releases the remaining halves without leaking callbacks.
+        if let Some(mut w) = self.writer.try_lock() {
+            w.take();
+        }
+        if let Some(mut r) = self.reader.try_lock() {
+            r.take();
+        }
+    }
+}
