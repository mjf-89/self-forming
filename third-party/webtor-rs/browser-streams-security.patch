+    /// `gated` applies the refresh freshness/backoff rules (used for on-demand
+    /// refresh, not for the initial load).
+    pub async fn load_in_order<F, Fut>(
+        &self,
+        seed: Option<&DirectorySeed>,
+        base_url: Option<&str>,
+        bridge_channel: Option<F>,
+        gated: bool,
+        cancel: Option<&CancellationToken>,
