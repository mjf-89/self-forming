+/// Exercise the bounded directory-download retry helper deterministically:
+/// `op` fails `fail_times` times (retryable) before succeeding, and `acquire`
+/// records the `force` flag it was called with each attempt. Returns
+/// `{ ok, opCalls, acquireForce }`.
+#[cfg(feature = "recovery-smoke")]
+#[wasm_bindgen(js_name = smokeRetryFresh)]
+pub async fn smoke_retry_fresh(attempts: usize, fail_times: u32) -> Result<JsValue, JsValue> {
+    let acquire_force: Rc<RefCell<Vec<bool>>> = Rc::new(RefCell::new(Vec::new()));
+    let op_calls: Rc<RefCell<u32>> = Rc::new(RefCell::new(0));
+    let remaining: Rc<RefCell<u32>> = Rc::new(RefCell::new(fail_times));
+
+    let acquire = {
+        let acquire_force = acquire_force.clone();
+        move |force: bool| {
+            acquire_force.borrow_mut().push(force);
+            async move { Ok::<u32, TorError>(if force { 1 } else { 0 }) }
+        }
+    };
+    let op = {
+        let op_calls = op_calls.clone();
+        let remaining = remaining.clone();
+        move |_ctx: u32| {
+            *op_calls.borrow_mut() += 1;
+            let fail = {
+                let mut r = remaining.borrow_mut();
+                if *r > 0 {
+                    *r -= 1;
+                    true
+                } else {
+                    false
+                }
+            };
+            async move {
+                if fail {
+                    Err(TorError::Network("transient dir stream failure".into()))
+                } else {
+                    Ok::<String, TorError>("done".into())
+                }
+            }
+        }
+    };
+
+    let result =
+        webtor::retry::retry_with_fresh(attempts, Duration::from_millis(1), acquire, op).await;
+    let obj = js_sys::Object::new();
+    let set = |k: &str, v: &JsValue| {
+        let _ = js_sys::Reflect::set(&obj, &JsValue::from_str(k), v);
+    };
+    set("ok", &JsValue::from_bool(result.is_ok()));
+    set("opCalls", &JsValue::from_f64(*op_calls.borrow() as f64));
+    let forces = js_sys::Array::new();
+    for f in acquire_force.borrow().iter() {
+        forces.push(&JsValue::from_bool(*f));
+    }
+    set("acquireForce", &forces);
+    Ok(obj.into())
+}
