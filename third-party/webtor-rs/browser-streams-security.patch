+// Regression for the Pending/partial-write contract in each framing layer.
+#[cfg(feature = "recovery-smoke")]
+#[wasm_bindgen(js_name = smokePartialFraming)]
+pub async fn smoke_partial_framing() -> Result<(), JsValue> {
+    use std::{
+        pin::Pin,
+        task::{Context, Poll},
+    };
+    struct Sink {
+        bytes: Rc<RefCell<Vec<u8>>>,
+        pending: bool,
+    }
+    impl futures::io::AsyncRead for Sink {
+        fn poll_read(
+            self: Pin<&mut Self>,
+            _: &mut Context<'_>,
+            _: &mut [u8],
+        ) -> Poll<std::io::Result<usize>> {
+            Poll::Pending
+        }
+    }
+    impl futures::io::AsyncWrite for Sink {
+        fn poll_write(
+            mut self: Pin<&mut Self>,
+            cx: &mut Context<'_>,
+            b: &[u8],
+        ) -> Poll<std::io::Result<usize>> {
+            self.pending = !self.pending;
+            if self.pending {
+                cx.waker().wake_by_ref();
+                return Poll::Pending;
+            }
+            let n = b.len().min(37);
+            self.bytes.borrow_mut().extend_from_slice(&b[..n]);
+            Poll::Ready(Ok(n))
+        }
+        fn poll_flush(self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<std::io::Result<()>> {
+            Poll::Ready(Ok(()))
+        }
+        fn poll_close(self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<std::io::Result<()>> {
+            Poll::Ready(Ok(()))
+        }
+    }
+    let data: Vec<u8> = (0..40000).map(|n| (n % 251) as u8).collect();
+    let output = Rc::new(RefCell::new(Vec::new()));
+    let mut turbo = webtor::turbo::TurboStream::new(Sink {
+        bytes: output.clone(),
+        pending: false,
+    });
+    turbo
+        .write_all(&data)
+        .await
+        .map_err(|e| stream_error(e.to_string()))?;
+    turbo
+        .flush()
+        .await
+        .map_err(|e| stream_error(e.to_string()))?;
+    let bytes = output.borrow();
+    let mut offset = 0;
+    let mut recovered = Vec::new();
+    while offset < bytes.len() {
+        let (frame, n) = webtor::turbo::TurboFrame::decode(&bytes[offset..])
+            .map_err(tor_error_to_js)?
+            .ok_or_else(|| stream_error("truncated Turbo frame".into()))?;
+        offset += n;
+        recovered.extend(frame.data);
+    }
+    if recovered != data {
+        return Err(stream_error("Turbo repeated/lost bytes".into()));
+    }
+    drop(bytes);
+    let output = Rc::new(RefCell::new(Vec::new()));
+    let mut smux = webtor::smux::SmuxStream::with_stream_id(
+        Sink {
+            bytes: output.clone(),
+            pending: false,
+        },
+        3,
+    );
+    smux.write_all(&data)
+        .await
+        .map_err(|e| stream_error(e.to_string()))?;
+    smux.flush()
+        .await
+        .map_err(|e| stream_error(e.to_string()))?;
+    let bytes = output.borrow();
+    let mut offset = 0;
+    let mut recovered = Vec::new();
+    while offset < bytes.len() {
+        let (frame, n) = webtor::smux::SmuxSegment::decode(&bytes[offset..])
+            .map_err(tor_error_to_js)?
+            .ok_or_else(|| stream_error("truncated SMUX frame".into()))?;
+        offset += n;
+        recovered.extend(frame.data);
+    }
+    if recovered != data {
+        return Err(stream_error("SMUX repeated/lost bytes".into()));
+    }
+    drop(bytes);
+    let output = Rc::new(RefCell::new(Vec::new()));
+    let mut sender = webtor::kcp_stream::KcpStream::new(
+        Sink {
+            bytes: output.clone(),
+            pending: false,
+        },
+        webtor::kcp_stream::KcpConfig::default(),
+    );
+    sender
+        .write_all(&data)
+        .await
+        .map_err(|e| stream_error(e.to_string()))?;
+    sender
+        .flush()
+        .await
+        .map_err(|e| stream_error(e.to_string()))?;
+    let mut receiver = kcp::Kcp::new_stream(0, std::io::sink());
+    receiver.set_wndsize(128, 128);
+    receiver
+        .input(&output.borrow())
+        .map_err(|e| stream_error(e.to_string()))?;
+    let mut recovered = Vec::new();
+    let mut buf = [0; 65536];
+    while let Ok(n) = receiver.recv(&mut buf) {
+        recovered.extend_from_slice(&buf[..n]);
+    }
+    if recovered != data {
+        return Err(stream_error(format!(
+            "KCP repeated/lost bytes: {} != {}",
+            recovered.len(),
+            data.len()
+        )));
+    }
+    Ok(())
+}
