+/// Push `total` bytes through the real Turbo -> KCP -> SMUX stack against a
+/// mock bridge peer, under WebSocket-like backpressure, and report what the
+/// peer actually received.
+///
+/// The mock enforces the two invariants the live Snowflake bridge enforces:
+/// every Turbo frame must be exactly one KCP datagram of at most 1500 bytes
+/// (its `turbotunnel` packet conn drops anything larger), and SMUX window is
+/// only granted after data has been consumed, so an upload bigger than one
+/// window must block and resume instead of failing.
+#[cfg(feature = "recovery-smoke")]
+#[wasm_bindgen(js_name = smokeStackUpload)]
+pub async fn smoke_stack_upload(total: usize, piece: usize) -> Result<JsValue, JsValue> {
+    use futures::io::{AsyncRead, AsyncWrite};
+    use std::collections::VecDeque;
+    use std::pin::Pin;
+    use std::task::{Context, Poll, Waker};
+
+    const MAX_DATAGRAM: usize = 1500;
+    const PEER_WINDOW: u32 = 64 * 1024;
+
+    #[derive(Default)]
+    struct Stats {
+        received: usize,
+        next_byte: u8,
+        problems: Vec<String>,
+        max_datagram: usize,
+        datagrams: usize,
+    }
+
+    #[derive(Clone, Default)]
+    struct PacketSink(Rc<RefCell<VecDeque<Vec<u8>>>>);
+    impl std::io::Write for PacketSink {
+        fn write(&mut self, buf: &[u8]) -> std::io::Result<usize> {
+            self.0.borrow_mut().push_back(buf.to_vec());
+            Ok(buf.len())
+        }
+        fn flush(&mut self) -> std::io::Result<()> {
+            Ok(())
+        }
+    }
+
+    struct MockBridge {
+        peer: kcp::Kcp<PacketSink>,
+        peer_out: PacketSink,
+        wire_rx: Vec<u8>,
+        smux_rx: Vec<u8>,
+        inbound: Vec<u8>,
+        clock: u32,
+        stall: bool,
+        reported: u32,
+        stats: Rc<RefCell<Stats>>,
+        read_waker: Option<Waker>,
+    }
+
+    impl MockBridge {
+        fn new(stats: Rc<RefCell<Stats>>) -> Self {
+            let peer_out = PacketSink::default();
+            let mut peer = kcp::Kcp::new_stream(0, peer_out.clone());
+            peer.set_nodelay(false, 100, 0, true);
+            peer.set_wndsize(128, 128);
+            Self {
+                peer,
+                peer_out,
+                wire_rx: Vec::new(),
+                smux_rx: Vec::new(),
+                inbound: Vec::new(),
+                clock: 0,
+                stall: false,
+                reported: 0,
+                stats,
+                read_waker: None,
+            }
+        }
+
+        fn tick(&mut self) {
+            self.clock = self.clock.wrapping_add(20);
+            let _ = self.peer.update(self.clock);
+            self.collect_peer_output();
+        }
+
+        fn collect_peer_output(&mut self) {
+            let packets: Vec<Vec<u8>> = self.peer_out.0.borrow_mut().drain(..).collect();
+            for packet in packets {
+                self.inbound
+                    .extend_from_slice(&webtor::turbo::TurboFrame::new(packet).encode());
+            }
+            if !self.inbound.is_empty() {
+                if let Some(waker) = self.read_waker.take() {
+                    waker.wake();
+                }
+            }
+        }
+
+        /// Decode whole Turbo frames; each must be exactly one KCP datagram.
+        fn consume_wire(&mut self) {
+            while let Ok(Some((frame, used))) = webtor::turbo::TurboFrame::decode(&self.wire_rx) {
+                self.wire_rx.drain(..used);
+                if frame.is_padding {
+                    continue;
+                }
+                {
+                    let mut stats = self.stats.borrow_mut();
+                    stats.datagrams += 1;
+                    stats.max_datagram = stats.max_datagram.max(frame.data.len());
+                    if frame.data.len() > MAX_DATAGRAM {
+                        stats.problems.push(format!(
+                            "datagram of {} bytes exceeds the {}-byte bridge packet limit",
+                            frame.data.len(),
+                            MAX_DATAGRAM
+                        ));
+                        continue;
+                    }
+                }
+                if self.peer.input(&frame.data).is_err() {
+                    self.stats
+                        .borrow_mut()
+                        .problems
+                        .push("peer rejected a KCP datagram".into());
+                    continue;
+                }
+                let mut buf = vec![0u8; 64 * 1024];
+                loop {
+                    match self.peer.recv(&mut buf) {
+                        Ok(0) | Err(_) => break,
+                        Ok(n) => self.smux_rx.extend_from_slice(&buf[..n]),
+                    }
+                }
+                self.consume_smux();
+            }
+            self.tick();
+        }
+
+        fn consume_smux(&mut self) {
+            while let Ok(Some((segment, used))) = webtor::smux::SmuxSegment::decode(&self.smux_rx) {
+                self.smux_rx.drain(..used);
+                if segment.command != webtor::smux::SmuxCommand::Psh {
+                    continue;
+                }
+                let received = {
+                    let mut stats = self.stats.borrow_mut();
+                    for byte in &segment.data {
+                        if *byte != stats.next_byte {
+                            let offset = stats.received;
+                            let expected = stats.next_byte;
+                            stats.problems.push(format!(
+                                "payload mismatch at offset {}: {} != {}",
+                                offset, byte, expected
+                            ));
+                            stats.next_byte = *byte;
+                        }
+                        stats.next_byte = stats.next_byte.wrapping_add(1);
+                        stats.received += 1;
+                    }
+                    stats.received as u32
+                };
+                // Grant window only after consuming, as smux v2 does.
+                if received.wrapping_sub(self.reported) >= PEER_WINDOW / 2 {
+                    self.reported = received;
+                    let upd =
+                        webtor::smux::SmuxSegment::upd(3, self.reported, PEER_WINDOW).encode();
+                    let _ = self.peer.send(&upd);
+                    let _ = self.peer.flush();
+                    self.collect_peer_output();
+                }
+            }
+        }
+    }
+
+    impl AsyncWrite for MockBridge {
+        fn poll_write(
+            mut self: Pin<&mut Self>,
+            cx: &mut Context<'_>,
+            buf: &[u8],
+        ) -> Poll<std::io::Result<usize>> {
+            // Alternate Pending to model WebSocket backpressure.
+            self.stall = !self.stall;
+            if self.stall {
+                cx.waker().wake_by_ref();
+                return Poll::Pending;
+            }
+            let n = buf.len().min(64 * 1024);
+            self.wire_rx.extend_from_slice(&buf[..n]);
+            self.consume_wire();
+            Poll::Ready(Ok(n))
+        }
+        fn poll_flush(mut self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<std::io::Result<()>> {
+            self.tick();
+            Poll::Ready(Ok(()))
+        }
+        fn poll_close(self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<std::io::Result<()>> {
+            Poll::Ready(Ok(()))
+        }
+    }
+
+    impl AsyncRead for MockBridge {
+        fn poll_read(
+            mut self: Pin<&mut Self>,
+            cx: &mut Context<'_>,
+            buf: &mut [u8],
+        ) -> Poll<std::io::Result<usize>> {
+            self.tick();
+            if self.inbound.is_empty() {
+                self.read_waker = Some(cx.waker().clone());
+                return Poll::Pending;
+            }
+            let n = buf.len().min(self.inbound.len());
+            buf[..n].copy_from_slice(&self.inbound[..n]);
+            self.inbound.drain(..n);
+            Poll::Ready(Ok(n))
+        }
+    }
+
+    let total = total.min(8 * 1024 * 1024);
+    let piece = piece.clamp(1, 256 * 1024);
+    let stats = Rc::new(RefCell::new(Stats::default()));
+    let mut stack = webtor::smux::SmuxStream::with_stream_id(
+        webtor::kcp_stream::KcpStream::new(
+            webtor::turbo::TurboStream::with_client_id(MockBridge::new(stats.clone()), [7u8; 8]),
+            webtor::kcp_stream::KcpConfig::default(),
+        ),
+        3,
+    );
+    stack.initialize().await.map_err(tor_error_to_js)?;
+    let (mut reader, mut writer) = futures::io::AsyncReadExt::split(stack);
+
+    // The bridge's ACKs/UPDs only arrive if something reads, exactly as the
+    // channel reactor does in production: drive both halves together.
+    let pump = async move {
+        let mut buf = [0u8; 8192];
+        loop {
+            match futures::io::AsyncReadExt::read(&mut reader, &mut buf).await {
+                Ok(0) | Err(_) => break,
+                Ok(_) => {}
+            }
+        }
+    };
+    let send = async move {
+        let mut sent = 0usize;
+        let mut next = 0u8;
+        while sent < total {
+            let len = piece.min(total - sent);
+            let chunk: Vec<u8> = (0..len)
+                .map(|_| {
+                    let b = next;
+                    next = next.wrapping_add(1);
+                    b
+                })
+                .collect();
+            writer.write_all(&chunk).await.map_err(|e| {
+                stream_error(format!("stack write failed after {} bytes: {}", sent, e))
+            })?;
+            sent += len;
+        }
+        writer
+            .flush()
+            .await
+            .map_err(|e| stream_error(format!("stack flush failed: {}", e)))?;
+        Ok::<usize, JsValue>(sent)
+    };
+    let sent = {
+        use futures::future::Either;
+        let pump = std::pin::pin!(pump);
+        let send = std::pin::pin!(send);
+        match futures::future::select(send, pump).await {
+            Either::Left((result, pump)) => {
+                let sent = result?;
+                // Keep reading briefly so the remaining in-flight window is
+                // acknowledged and flushed by the KCP timer.
+                let _ = webtor::with_timeout(Duration::from_secs(5), "stack_drain", async move {
+                    pump.await;
+                    Ok::<(), TorError>(())
+                })
+                .await;
+                sent
+            }
+            Either::Right(((), _)) => return Err(stream_error("mock bridge closed early".into())),
+        }
+    };
+
+    let stats = stats.borrow();
+    let result = serde_json::json!({
+        "sent": sent,
+        "received": stats.received,
+        "datagrams": stats.datagrams,
+        "maxDatagram": stats.max_datagram,
+        "problems": stats.problems,
+    });
+    serde_wasm_bindgen::to_value(&result).map_err(|e| stream_error(e.to_string()))
+}
