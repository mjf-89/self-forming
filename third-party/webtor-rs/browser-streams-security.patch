+/// Bounded retry around an idempotent operation that runs on a resource which
+/// can be rebuilt (e.g. the bridge directory download on a one-hop channel).
+///
+/// `acquire(force)` obtains the resource; on a retry it is called with
+/// `force = true` so the caller can discard a stalled/dead resource and build a
+/// fresh one. `op` runs the idempotent operation on that resource.
+///
+/// Only *`op`* failures drive retries: a retryable `op` error reacquires the
+/// resource fresh and repeats after `backoff * n`, up to `attempts` total. An
+/// `acquire` failure (e.g. the bridge channel cannot be connected at all)
+/// returns immediately — connecting has its own timeout/retry, and there is
+/// nothing to retry the operation on — so a hard-down transport fails fast
+/// instead of waiting out the backoff. A non-retryable `op` error (or a
+/// retryable one on the last attempt) also stops immediately.
+pub async fn retry_with_fresh<Ctx, A, AFut, O, OFut, T>(
+    attempts: usize,
+    backoff: Duration,
+    acquire: A,
+    op: O,
+) -> Result<T>
+where
+    A: Fn(bool) -> AFut,
+    AFut: Future<Output = Result<Ctx>>,
+    O: Fn(Ctx) -> OFut,
+    OFut: Future<Output = Result<T>>,
+{
+    let attempts = attempts.max(1);
+    let mut last: Option<TorError> = None;
+    for attempt in 0..attempts {
+        if attempt > 0 {
+            sleep(backoff.saturating_mul(attempt as u32)).await;
+        }
+        // Acquiring the resource is not itself retried here: a failure to
+        // connect fails fast with its own error.
+        let ctx = acquire(attempt > 0).await?;
+        match op(ctx).await {
+            Ok(value) => return Ok(value),
+            Err(e) => {
+                let can_retry = e.is_retryable() && attempt + 1 < attempts;
+                if can_retry {
+                    warn!(
+                        "retry_with_fresh attempt {}/{} failed (retrying): {}",
+                        attempt + 1,
+                        attempts,
+                        e
+                    );
+                }
+                last = Some(e);
+                if !can_retry {
+                    break;
+                }
+            }
+        }
+    }
+    Err(last.unwrap_or_else(|| TorError::Internal("retry_with_fresh: no attempts".into())))
+}
+
 /// Platform-agnostic sleep function
