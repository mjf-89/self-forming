+            if !self.needs_refresh() {
+                return Ok(DirectoryLoadOutcome::StillFresh);
+            }
+            if now < self.next_refresh_attempt.load(Ordering::SeqCst) {
+                return Ok(DirectoryLoadOutcome::Backoff);
+            }
+            self.next_refresh_attempt
+                .store(now.saturating_add(REFRESH_BACKOFF), Ordering::SeqCst);
+        }
+        let _budget = DirectoryBudget::reserve()?;
+        self.last_load_bytes.store(0, Ordering::SeqCst);
