+            match self.install_seed(seed).await {
+                Ok(()) => {
+                    info!("Directory seed accepted ({} relays)", self.relay_count().await);
+                    return Ok(DirectoryLoadOutcome::Loaded(DirectorySourceKind::Seed));
+                }
+                Err(e) => {
+                    // Not fatal and not a downgrade: the next source is tried
+                    // with exactly the same checks.
+                    warn!("Ignoring directory seed: {}", e);
+                    last_error = Some(e);
+                }
+            }
+        }
