+        self.0.supported_schemes()
+    }
+
+    fn root_hint_subjects(&self) -> Option<&[rustls::DistinguishedName]> {
+        // We don't actually want to send any DNs for our root certs,
+        // since they aren't real.
+        None
+    }
+}
