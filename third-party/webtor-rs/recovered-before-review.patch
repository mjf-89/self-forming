+    /// Open a raw TCP stream to `host:port` through a Tor exit (RELAY_BEGIN).
+    ///
+    /// The circuit is chosen like for HTTP requests: by the client's stream
+    /// isolation policy, keyed on `host`. No webtor lock is held once this
+    /// returns, so many streams can be open and idle at the same time.
+    /// `timeout` defaults to the configured circuit timeout.
+    pub async fn connect_stream(
+        &self,
+        host: &str,
+        port: u16,
+        timeout: Option<Duration>,
+    ) -> Result<DataStream> {
+        let timeout = timeout.unwrap_or_else(|| self.options.circuit_timeout_duration());
+        with_timeout_and_cancellation(timeout, "connect_stream", &self.shutdown_token, async {
+            // Isolation key derived as for an http URL to the same host and port.
+            let key_url = if host.contains(':') && !host.starts_with('[') {
+                Url::parse(&format!("http://[{}]:{}/", host, port))?
+            } else {
+                Url::parse(&format!("http://{}:{}/", host, port))?
+            };
+            let isolation_key = IsolationKey::from_url(&key_url, self.options.stream_isolation);
+
+            let circuit_manager = self.circuit_manager.read().await;
+            // A bad exit (unreachable, DNS failure) would otherwise stay bound to
+            // this isolation key: on failure mark the circuit failed and retry
+            // once on a fresh circuit. Each attempt gets half of the budget.
+            let mut attempt = 0;
+            let stream = loop {
+                attempt += 1;
+                let circuit = circuit_manager
+                    .get_circuit_for_isolation_key(isolation_key.clone())
+                    .await?;
+                let result = with_timeout(timeout / 2, "begin_stream", async {
+                    circuit.read().await.begin_stream(host, port).await
+                })
+                .await;
+                match result {
+                    Ok(stream) => break stream,
+                    Err(e) if attempt < 2 && !matches!(e, TorError::Cancelled) => {
+                        warn!("connect {}:{} failed ({}), retrying on a new circuit", host, port, e);
+                        circuit.write().await.status = CircuitStatus::Failed;
+                    }
+                    Err(e) => return Err(e),
+                }
+            };
+
+            circuit_manager
+                .maybe_prebuild_circuit(
+                    MAX_CIRCUITS,
+                    Duration::from_millis(CIRCUIT_PREBUILD_AGE_THRESHOLD_MS),
+                )
+                .await;
+            Ok(stream)
+        })
+        .await
+    }
