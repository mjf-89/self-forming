+#[cfg(feature = "recovery-smoke")]
+#[wasm_bindgen(js_name = smokeTls)]
+pub async fn smoke_tls(url: String, host: String) -> Result<TorStream, JsValue> {
+    let connector = tls_connector().map_err(|e| stream_error(e.to_string()))?;
+    let name = rustls::pki_types::ServerName::try_from(host)
+        .map_err(|e| stream_error(e.to_string()))?;
+    let stream = webtor::websocket::WebSocketStream::connect(&url)
+        .await.map_err(tor_error_to_js)?;
+    let tls = connector.connect(name, stream).await
+        .map_err(|e| stream_error(e.to_string()))?;
+    Ok(TorStream::new(tls))
+}
