+/// Tor voting-authority RSA identities, pinned independently of downloaded data.
+/// Source: vendored Arti tor-dircommon/src/authority.rs at upstream cba29fb.
+/// A strict majority of the entire set (5 of 9), never just the supplied certs.
+const AUTHORITY_IDS: [&str; 9] = [
+    "27102BC123E7AF1D4741AE047E160C91ADC76B21", // bastet
+    "0232AF901C31A04EE9848595AF9BB7620D4C5B2E", // dannenberg
+    "E8A9C45EDE6D711294FADF8E7951F4DE6CA56B58", // dizum
+    "70849B868D606BAECFB6128C5E3D782029AA394F", // faravahar
+    "ED03BB616EB2F60BEC80151114BB25CEF515B226", // gabelmoo
+    "23D15D965BC35114467363C165C4F724B64B4F66", // longclaw
+    "49015F787433103580E3B66A1707A00E60F2D15B", // maatuska
+    "F533C81CEF0BC0267857C99B2F471ADF249FA232", // moria1
+    "2F3DF9CA0E5D36F2685A2DA67184EB8DCB8CBA8C", // tor26
+];
+
+/// Authenticate before exposing router status data. No trust overrides.
+pub fn authenticate_consensus(body: &str, certificates: &str) -> Result<MdConsensus> {
+    let fail = |e: String| TorError::ConsensusFetch(format!("Directory authentication: {}", e));
+    if body.len() > 16 * 1024 * 1024 || certificates.len() > 1024 * 1024 {
+        return Err(fail("input exceeds size limit".into()));
+    }
+    let now = system_time_now();
+    let mut certs = Vec::new();
+    for cert in AuthCert::parse_multiple(certificates).map_err(|e| fail(e.to_string()))? {
+        // Ignore invalid/expired/untrusted certs, but they never count toward quorum.
+        let Ok(cert) = cert else { continue };
+        let Ok(cert) = cert.check_signature() else { continue };
+        let Ok(cert) = cert.check_valid_at(&now) else { continue };
+        let identity = hex::encode_upper(cert.id_fingerprint().as_bytes());
+        if AUTHORITY_IDS.contains(&identity.as_str()) { certs.push(cert); }
+    }
+    let (_, _, unchecked) = MdConsensus::parse(body).map_err(|e| fail(e.to_string()))?;
+    let timely = unchecked.check_valid_at(&now).map_err(|e| fail(e.to_string()))?;
+    // Arti's parsing bound includes the pre-publication voting distribution
+    // interval. Bootstrap must use the advertised lifetime, not that grace.
+    let lifetime = timely.peek_lifetime();
+    if now < lifetime.valid_after() || now >= lifetime.valid_until() {
+        return Err(fail("consensus is outside its advertised validity interval".into()));
+    }
+    timely.set_n_authorities(AUTHORITY_IDS.len() as u16)
+        .check_signature(&certs).map_err(|e| fail(e.to_string()))
+}
