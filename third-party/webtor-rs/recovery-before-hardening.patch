+// --- Raw streams -----------------------------------------------------------
+
+/// Maximum number of bytes returned by one `TorStream.read()`.
+const READ_CHUNK: usize = 64 * 1024;
+
+type Reader = Box<dyn futures::io::AsyncRead + Unpin>;
+type Writer = Box<dyn futures::io::AsyncWrite + Unpin>;
+
+/// rustls needs a clock; `SystemTime::now()` panics on wasm32-unknown-unknown.
+#[derive(Debug)]
+struct JsClock;
+
+impl rustls::time_provider::TimeProvider for JsClock {
+    fn current_time(&self) -> Option<rustls::pki_types::UnixTime> {
+        let ms = js_sys::Date::now();
+        (ms.is_finite() && ms > 0.0).then(|| {
+            rustls::pki_types::UnixTime::since_unix_epoch(Duration::from_millis(ms as u64))
+        })
+    }
+}
+
+/// TLS 1.3 only (no version fallback), webpki certificate path validation
+/// against the Mozilla root set (webpki-roots), ALPN http/1.1.
+fn tls_connector() -> std::result::Result<futures_rustls::TlsConnector, rustls::Error> {
+    let provider = Arc::new(rustls::crypto::ring::default_provider());
+    let roots = rustls::RootCertStore {
+        roots: webpki_roots::TLS_SERVER_ROOTS.to_vec(),
+    };
+    let mut config = rustls::ClientConfig::builder_with_details(provider, Arc::new(JsClock))
+        .with_protocol_versions(&[&rustls::version::TLS13])?
+        .with_root_certificates(roots)
+        .with_no_client_auth();
+    config.alpn_protocols = vec![b"http/1.1".to_vec()];
+    Ok(futures_rustls::TlsConnector::from(Arc::new(config)))
+}
+
+fn stream_error(message: String) -> JsValue {
+    JsTorError::from_str("STREAM", "network", &message, false).into_js_value()
+}
+
+/// A bidirectional byte stream through a Tor exit.
+///
+/// The read and write halves are locked independently, so a pending `read()`
+/// never blocks `write()`. Call `close()` when done (idempotent).
+#[wasm_bindgen]
+pub struct TorStream {
+    reader: Rc<futures::lock::Mutex<Option<Reader>>>,
+    writer: Rc<futures::lock::Mutex<Option<Writer>>>,
+    /// Cancels the read in progress (used by `close()`).
+    pending_read: Rc<RefCell<Option<AbortHandle>>>,
+    pending_write: Rc<RefCell<Option<AbortHandle>>>,
+    closed: Rc<Cell<bool>>,
+}
+
+impl TorStream {
+    fn new<S>(stream: S) -> Self
+    where
+        S: futures::io::AsyncRead + futures::io::AsyncWrite + Unpin + 'static,
+    {
+        let (reader, writer) = futures::io::AsyncReadExt::split(stream);
+        TorStream {
+            reader: Rc::new(futures::lock::Mutex::new(Some(Box::new(reader) as Reader))),
+            writer: Rc::new(futures::lock::Mutex::new(Some(Box::new(writer) as Writer))),
+            pending_read: Rc::new(RefCell::new(None)),
+            pending_write: Rc::new(RefCell::new(None)),
+            closed: Rc::new(Cell::new(false)),
+        }
+    }
+}
+
+#[wasm_bindgen]
+impl TorStream {
+    /// Write all of `data` and flush it to the circuit.
+    #[wasm_bindgen(unchecked_return_type = "Promise<void>")]
+    pub fn write(&self, data: Vec<u8>) -> js_sys::Promise {
+        let writer = self.writer.clone();
+        let closed = self.closed.clone();
+        let pending_write = self.pending_write.clone();
+        future_to_promise(async move {
+            let mut guard = writer.lock().await;
+            if closed.get() { return Err(stream_error("stream is closed".into())); }
+            let w = guard.as_mut().ok_or_else(|| stream_error("stream is closed".into()))?;
+            let (abort, registration) = AbortHandle::new_pair();
+            *pending_write.borrow_mut() = Some(abort);
+            let result = Abortable::new(async {
+                w.write_all(&data).await?;
+                w.flush().await
+            }, registration).await;
+            pending_write.borrow_mut().take();
+            match result {
+                Ok(Ok(())) => Ok(JsValue::UNDEFINED),
+                Ok(Err(e)) => Err(stream_error(format!("write failed: {}", e))),
+                Err(_) => Err(stream_error("stream closed during write".into())),
+            }
+        })
+    }
+
+    /// Next available chunk (at most 64 KiB), or `undefined` at EOF / after close.
+    #[wasm_bindgen(unchecked_return_type = "Promise<Uint8Array | undefined>")]
+    pub fn read(&self) -> js_sys::Promise {
+        let reader = self.reader.clone();
+        let pending_read = self.pending_read.clone();
+        let closed = self.closed.clone();
+        future_to_promise(async move {
+            let mut guard = reader.lock().await;
+            let Some(r) = guard.as_mut() else {
+                return Ok(JsValue::UNDEFINED);
+            };
+            if closed.get() {
+                *guard = None;
+                return Ok(JsValue::UNDEFINED);
+            }
+            let (abort, registration) = AbortHandle::new_pair();
+            *pending_read.borrow_mut() = Some(abort);
+            let mut buf = vec![0u8; READ_CHUNK];
+            let result = Abortable::new(r.read(&mut buf), registration).await;
+            pending_read.borrow_mut().take();
+            match result {
+                Ok(Ok(n)) if n > 0 => Ok(js_sys::Uint8Array::from(&buf[..n]).into()),
+                Ok(Ok(_)) | Err(_) => {
+                    // EOF, or aborted by close()
+                    *guard = None;
+                    Ok(JsValue::UNDEFINED)
+                }
+                Ok(Err(e)) => Err(stream_error(format!("read failed: {}", e))),
+            }
+        })
+    }
+
+    /// Close the stream (idempotent). A pending `read()` resolves `undefined`.
+    #[wasm_bindgen(unchecked_return_type = "Promise<void>")]
+    pub fn close(&self) -> js_sys::Promise {
+        let reader = self.reader.clone();
+        let writer = self.writer.clone();
+        let pending_read = self.pending_read.clone();
+        let pending_write = self.pending_write.clone();
+        let closed = self.closed.clone();
+        future_to_promise(async move {
+            if closed.replace(true) {
+                return Ok(JsValue::UNDEFINED);
+            }
+            if let Some(abort) = pending_read.borrow_mut().take() {
+                abort.abort();
+            }
+            if let Some(abort) = pending_write.borrow_mut().take() { abort.abort(); }
+            // Dropping both halves drops the DataStream, which ends the Tor stream.
+            let writer = writer.lock().await.take();
+            drop(writer);
+            reader.lock().await.take();
+            Ok(JsValue::UNDEFINED)
+        })
+    }
+}
