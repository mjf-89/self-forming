+/// Authenticate a directory consensus with the same pin/quorum/time checks
+/// used during bootstrap. Useful for snapshot diagnostics; never sets trust.
+#[wasm_bindgen(js_name = validateDirectory)]
+pub fn validate_directory(consensus: &str, certificates: &str) -> Result<u32, JsValue> {
+    webtor::directory::authenticate_consensus(consensus, certificates)
+        .map(|c| c.relays().len() as u32).map_err(tor_error_to_js)
+}
