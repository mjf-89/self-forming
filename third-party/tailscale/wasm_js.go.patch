+// argTimeout extracts an optional timeout (milliseconds) from args[idx],
+// defaulting to 30s when absent or non-positive.
+func argTimeout(args []js.Value, idx int) time.Duration {
+	if len(args) > idx && args[idx].Type() == js.TypeNumber {
+		if ms := args[idx].Float(); ms > 0 {
+			return time.Duration(ms) * time.Millisecond
+		}
+	}
+	return 30 * time.Second
+}
+
+// portOf parses a JS port argument that may be a number or a string.
+func portOf(v js.Value) (int, error) {
+	switch v.Type() {
+	case js.TypeNumber:
+		return v.Int(), nil
+	case js.TypeString:
+		n, err := netip.ParseAddrPort(net.JoinHostPort("0.0.0.0", v.String()))
+		if err != nil {
+			return 0, fmt.Errorf("invalid port %q", v.String())
+		}
+		return int(n.Port()), nil
+	default:
+		return 0, fmt.Errorf("invalid port")
+	}
+}
+
+// exitNodes returns exit-node-capable peers from the current status.
+func (i *jsIPN) exitNodes() any {
+	st := i.lb.Status()
+	out := make([]any, 0)
+	if st == nil {
+		return out
 	}
+	for _, p := range st.Peer {
+		if p == nil || !p.ExitNodeOption {
+			continue
+		}
+		ip := ""
+		if len(p.TailscaleIPs) > 0 {
+			ip = p.TailscaleIPs[0].String()
+		}
+		name := strings.TrimSuffix(p.DNSName, ".")
+		if name == "" {
+			name = p.HostName
+		}
+		out = append(out, map[string]any{
+			"id":     string(p.ID),
+			"name":   name,
+			"ip":     ip,
+			"online": p.Online,
+		})
+	}
+	return out
+}
+
+// exitNodeDiag reports exit-node availability from the current netmap.
+func (i *jsIPN) exitNodeDiag() any {
+	nm := i.lb.NetMapWithPeers()
+	res := map[string]any{"peers": 0, "advertising": 0, "usable": 0, "advertisingNames": []any{}}
+	if nm == nil {
+		return res
+	}
+	advertising := 0
+	usable := 0
+	names := make([]any, 0)
+	for _, p := range nm.Peers {
+		if tsaddr.ContainsExitRoutes(p.AllowedIPs()) {
+			usable++
+		}
+		if hi := p.Hostinfo(); hi.Valid() && tsaddr.ContainsExitRoutes(hi.RoutableIPs()) {
+			advertising++
+			name := strings.TrimSuffix(p.Name(), ".")
+			if name == "" {
+				name = hi.Hostname()
+			}
+			names = append(names, name)
+		}
+	}
+	res["peers"] = len(nm.Peers)
+	res["advertising"] = advertising
+	res["usable"] = usable
+	res["advertisingNames"] = names
+	return res
+}
+
+// setExitNode selects an exit node by StableNodeID or Tailscale IP.
+func (i *jsIPN) setExitNode(idOrIP string) js.Value {
+	return makePromise(func() (any, error) {
+		mp := &ipn.MaskedPrefs{}
+		if ip, err := netip.ParseAddr(idOrIP); err == nil {
+			// Clear any prior ID so EditPrefs accepts the IP form.
+			mp.Prefs.ExitNodeID = ""
+			mp.ExitNodeIDSet = true
+			mp.Prefs.ExitNodeIP = ip
+			mp.ExitNodeIPSet = true
+		} else {
+			mp.Prefs.ExitNodeID = tailcfg.StableNodeID(idOrIP)
+			mp.ExitNodeIDSet = true
+			mp.Prefs.ExitNodeIP = netip.Addr{}
+			mp.ExitNodeIPSet = true
+		}
+		if _, err := i.lb.EditPrefs(mp); err != nil {
+			return nil, err
+		}
+		return nil, nil
+	})
+}
+
+// clearExitNode unsets any selected exit node.
+func (i *jsIPN) clearExitNode() js.Value {
+	return makePromise(func() (any, error) {
+		mp := &ipn.MaskedPrefs{ExitNodeIDSet: true, ExitNodeIPSet: true}
+		mp.Prefs.ExitNodeID = ""
+		mp.Prefs.ExitNodeIP = netip.Addr{}
+		if _, err := i.lb.EditPrefs(mp); err != nil {
+			return nil, err
+		}
+		return nil, nil
+	})
+}
+
+// dial opens a plain TCP stream through the netstack user dialer.
+func (i *jsIPN) dial(host string, portVal js.Value, timeout time.Duration) js.Value {
+	return makePromise(func() (any, error) {
+		port, err := portOf(portVal)
+		if err != nil {
+			return nil, err
+		}
+		ctx, cancel := context.WithTimeout(context.Background(), timeout)
+		defer cancel()
+		conn, err := i.dialer.UserDial(ctx, "tcp", net.JoinHostPort(host, fmt.Sprint(port)))
+		if err != nil {
+			return nil, err
+		}
+		return newJSStream(conn), nil
+	})
+}
+
+// dialTLS opens a TLS (1.2+) stream through the netstack user dialer. It
+// verifies the server certificate against bundled roots, uses ServerName=host
+// and advertises ALPN http/1.1.
+func (i *jsIPN) dialTLS(host string, portVal js.Value, timeout time.Duration) js.Value {
+	return makePromise(func() (any, error) {
+		port, err := portOf(portVal)
+		if err != nil {
+			return nil, err
+		}
+		ctx, cancel := context.WithTimeout(context.Background(), timeout)
+		defer cancel()
+		conn, err := i.dialer.UserDial(ctx, "tcp", net.JoinHostPort(host, fmt.Sprint(port)))
+		if err != nil {
+			return nil, err
+		}
+		tlsConn := tls.Client(conn, &tls.Config{
+			ServerName: host,
+			MinVersion: tls.VersionTLS12,
+			NextProtos: []string{"http/1.1"},
+		})
+		if err := tlsConn.HandshakeContext(ctx); err != nil {
+			conn.Close()
+			return nil, err
+		}
+		return newJSStream(tlsConn), nil
+	})
+}
+
+// newJSStream wraps a net.Conn as a JS object exposing read/write/close with
+// Promise-returning methods, matching the transport stream API used by the
+// browser app. read resolves a Uint8Array (<=64 KiB) or undefined at EOF;
+// write accepts a Uint8Array; concurrent read+write are allowed; close is
+// idempotent.
+func newJSStream(conn net.Conn) map[string]any {
+	var closeOnce sync.Once
+	return map[string]any{
+		"read": js.FuncOf(func(this js.Value, args []js.Value) any {
+			return makePromise(func() (any, error) {
+				buf := make([]byte, 64*1024)
+				n, err := conn.Read(buf)
+				if n > 0 {
+					arr := js.Global().Get("Uint8Array").New(n)
+					js.CopyBytesToJS(arr, buf[:n])
+					return arr, nil
+				}
+				if err == nil || err == io.EOF || errIsClosed(err) {
+					return js.Undefined(), nil
+				}
+				return nil, err
+			})
+		}),
+		"write": js.FuncOf(func(this js.Value, args []js.Value) any {
+			if len(args) != 1 {
+				return makePromise(func() (any, error) { return nil, fmt.Errorf("Usage: write(Uint8Array)") })
+			}
+			n := args[0].Get("length").Int()
+			b := make([]byte, n)
+			js.CopyBytesToGo(b, args[0])
+			return makePromise(func() (any, error) {
+				if _, err := conn.Write(b); err != nil {
+					return nil, err
+				}
+				return nil, nil
+			})
+		}),
+		"close": js.FuncOf(func(this js.Value, args []js.Value) any {
+			return makePromise(func() (any, error) {
+				closeOnce.Do(func() { conn.Close() })
+				return nil, nil
+			})
+		}),
+	}
+}
+
+// errIsClosed reports whether err indicates a closed connection/stream.
+func errIsClosed(err error) bool {
+	return err == net.ErrClosed || (err != nil && strings.Contains(err.Error(), "use of closed"))
 }
 
