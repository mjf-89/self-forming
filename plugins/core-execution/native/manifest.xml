<?xml version="1.0" encoding="utf-8"?>
<!-- core-execution, native half: merged into the APK manifest by apps/android/app/build.gradle.kts (docs/plugins.md §3a).
     Permissions shared with the host (AgentService) are repeated here so this plugin stays self-contained. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application>
        <service android:name="md.incept.selfforming.ExecutionService" android:exported="false"
            android:stopWithTask="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started local development commands and loopback servers, with an ongoing notification and an explicit Stop action; stops when no commands remain." />
        </service>
    </application>
</manifest>
